# ─────────────────────────────────────────────────────────────────────────────
#  Lydia Auction House — environment variables
#  The design-source archive contained ZERO environment variables (see
#  DESIGN-INVENTORY.md §10). Every name below is defined by this build.
#  Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Lydia Auction House

# ── Google reCAPTCHA v3 (invisible) + v2 checkbox fallback ───────────────────
# Site key is public by design; it is embedded in the client bundle.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key is server-side ONLY. Never expose, never prefix with NEXT_PUBLIC_.
RECAPTCHA_SECRET_KEY=
# v2 fallback is presented when the v3 score is below RECAPTCHA_SCORE_THRESHOLD.
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
# Set to "true" to skip verification entirely. LOCAL/CI ONLY — refused in production.
RECAPTCHA_DEV_BYPASS=true

# ── Vercel KV — live bids, auction state, bidder sessions ────────────────────
# Provision via Vercel dashboard → Storage → KV. These three names are injected
# automatically when the KV store is linked to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
# Upstash-native aliases (accepted as an alternative by src/lib/store.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Vercel Blob — artwork submission photos, results PDF ─────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Nodemailer (private sale enquiries, seller submissions) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# "Name <address@example.com>" — used as the From: of outbound mail.
MAIL_FROM="Lydia Auction House <no-reply@lydiaauctionhouse.co.ke>"
# Internal inbox that receives submissions and enquiries.
MAIL_TO=enquiries@lydiaauctionhouse.co.ke

# ── Contact / WhatsApp ───────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
NEXT_PUBLIC_GALLERY_PHONE=+254 112 272 061
NEXT_PUBLIC_GALLERY_EMAIL=enquiries@lydiaauctionhouse.co.ke
NEXT_PUBLIC_GALLERY_ADDRESS=The Loft, 2nd Floor, Kimathi Street, Nairobi CBD, Nairobi, Kenya

# ── Live auction realtime ────────────────────────────────────────────────────
# WebSocket endpoint. Leave blank to auto-derive (wss://<host>/api/ws).
NEXT_PUBLIC_WS_URL=
# Seconds between forced refetches when transport degrades to polling (brief: 2).
NEXT_PUBLIC_BID_POLL_MS=2000

# ── Rate limiting (Edge middleware + bid endpoints) ──────────────────────────
RATE_LIMIT_BID_PER_MIN=12
RATE_LIMIT_FORM_PER_MIN=5

# ── Feature flags ────────────────────────────────────────────────────────────
# Master switch for the Three.js featured-lot render (EFFECT-01).
NEXT_PUBLIC_ENABLE_3D=true
